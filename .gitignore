# ==============================================================================
# .gitignore - Git Ignore Configuration
# ==============================================================================

# macOS / OS Files
.DS_Store
._*
Thumbs.db

# ------------------------------------------------------------------------------
# 1. Build- & Distributionsordner
# ------------------------------------------------------------------------------
dist/
build/
out/
bin/
obj/
target/
.build/
DerivedData/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
cmake-build-*/
.gradle/
.mvn/
.next/
.nuxt/
.cache/

# ------------------------------------------------------------------------------
# 2. Kompilierte Binaries, Libraries & Ausführbare Dateien
# ------------------------------------------------------------------------------
ciy_ctl
CIYX79Control.app
*.app/
CIYX79Control-*.dmg
*.dmg
*.pkg
*.ipa
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
*.bin
*.out
*.dSYM/
*.class
*.pyc
*.pyo
*.pyd
__pycache__/
*.wasm

# Archive & Packaging
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# ------------------------------------------------------------------------------
# 3. Große JSON-Test-Dumps, Fixtures & Rohdaten
# ------------------------------------------------------------------------------
*.dump
*.dump.json
*dump*.json
*fixture*.json
*.large.json
large_*.json
*.raw.json
dumps/
test_dumps/
fixtures/dumps/
*.har
*.heapdump
*.cpuprofile
*.sqlite
*.sqlite3
*.db
*.csv.dump
*.sql.dump

# ------------------------------------------------------------------------------
# 4. Log-Dateien & Crash-Reports
# ------------------------------------------------------------------------------
*.log
*.log.*
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.trace
*.crash
*.stackdump

# ------------------------------------------------------------------------------
# 5. Drittanbieter-Libraries & Abhängigkeiten
# ------------------------------------------------------------------------------
node_modules/
vendor/
Pods/
Carthage/
venv/
.venv/
env/
.env/
virtualenv/
.pnpm-store/

# ------------------------------------------------------------------------------
# 6. Generierte Dokumentationen & Coverage-Reports
# ------------------------------------------------------------------------------
docs/_build/
docs/site/
site/
typedoc/
javadoc/
doxygen/
doc/html/
doc/latex/
coverage/
.nyc_output/
htmlcov/
*.lcov
*.gcov
report/
reports/

# ------------------------------------------------------------------------------
# 7. Temporäre Dateien & Clang Static Analyzer Reports
# ------------------------------------------------------------------------------
*.tmp
*.temp
*~
*.swp
*.bak
/*.plist

# ------------------------------------------------------------------------------
# 8. Lokale Agenten- & Tooling-Konfigurationen
# ------------------------------------------------------------------------------
.kilo/
.kilocoderules
.kiloignore
AGENTS.md
docs/agent/

